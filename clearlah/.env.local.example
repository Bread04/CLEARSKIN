# ─── ClearLah Environment Variables ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is git-ignored.

# ─── AI / LLM API ─────────────────────────────────────────────────────────────
# API key for the CodeBuddy / LLM service used for conversational log parsing
CODEBUDDY_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
# NEXT_PUBLIC_ prefix makes URL and anon key available to browser client.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — only for server-side use (bypasses RLS in demo mode)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Weather ──────────────────────────────────────────────────────────────────
# Set to "true" to use mock weather data instead of NEA API
# Use "true" in demo/CI environments; leave blank or "false" for production
USE_MOCK_WEATHER=true

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# Set to "true" to activate demo mode:
#   - Bypasses auth (uses demo-user-001)
#   - Shows "Demo Mode" badge
#   - All queries use demo seed data
NEXT_PUBLIC_DEMO_MODE=false
